# Configuração do Servidor
PORTA=3000
JWT_SEGREDO=
JWT_VALIDADE=900

# Variáveis para simulação de ensaios e testes da ficha prática API05 (desligadas por omissão)
# Se 1: destrói a socket na 1ª vez que cada chave é processada, simulando perda de resposta
SIMULAR_PERDA_RESPOSTA=0

# Se > 0: os próximos n pedidos POST /v2/sugestoes recebem 503 com Retry-After: 2
SIMULAR_503=0
